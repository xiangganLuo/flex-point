<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.xiangganluo</groupId>
        <artifactId>flexpoint-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>flexpoint-springboot</artifactId>
    <name>Flex Point Spring Boot</name>
    <description>扩展点框架Spring Boot自动配置模块</description>

    <dependencies>
        <!-- 内部依赖 -->
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-core</artifactId>
        </dependency>

        <!-- 官方插件（optional：消费方按需引入对应插件模块，本模块仅用于「配置即装配」的条件装配） -->
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-tag</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-gray</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-ab</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-weight</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-tenant</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-audit</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-slowcall</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-metrics</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-retry</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-resilience</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-observability</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-code</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.xiangganluo</groupId>
            <artifactId>flexpoint-plugin-selector-code-version</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot依赖 接入方自行引入Spring Boot 版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 外部依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project> 
